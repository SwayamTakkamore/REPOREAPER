# REPOREAPER — Environment Configuration
# Copy this file to .env.local and adjust as needed.
# Never commit .env.local (it is git-ignored).

# ---------------------------------------------------------------------------
# AI revival engine
# ---------------------------------------------------------------------------
# Provider selection:
#   - "huggingface" (default): Local Hugging Face inference via TGI, vLLM,
#     or the built-in local server (bun run hf:serve / python3 scripts/hf_local_server.py).
#   - "ollama": Local Ollama daemon.
#   - "fallback" / "none" / "disabled": Offline deterministic synthesis.
# If the local inference endpoint is unreachable, the engine automatically
# degrades to the deterministic fallback so an analysis never crashes.
AI_PROVIDER=huggingface

# Model identifier served by the local Hugging Face inference server or TGI.
# Examples: google/gemma-3-1b-it, google/gemma-2-2b-it, HuggingFaceTB/SmolLM-135M-Instruct
AI_MODEL=google/gemma-3-1b-it

# Base URL of the local Hugging Face inference server (standard port: 8080).
HF_BASE_URL=http://localhost:8080

# Optional: Hugging Face access token for private/gated model snapshots.
# HF_TOKEN=

# Base URL of the local Ollama daemon (if using AI_PROVIDER=ollama).
# OLLAMA_BASE_URL=http://localhost:11434

# Per-request inference timeout in milliseconds.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Analyzer limits (optional overrides; safe defaults are built in)
# ---------------------------------------------------------------------------
# REPOREAPER_SCAN_ROOT=/tmp/reporeaper-scans
# REPOREAPER_MAX_FILES=1000
# REPOREAPER_MAX_DEPTH=6
# REPOREAPER_MAX_FILE_BYTES=512000
# REPOREAPER_MAX_REPO_BYTES=52428800
# REPOREAPER_CLONE_TIMEOUT_MS=30000
