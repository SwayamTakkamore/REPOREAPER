# REPOREAPER — Environment Configuration
# Copy this file to .env.local and adjust as needed.
# Never commit .env.local (it is git-ignored).

# ---------------------------------------------------------------------------
# AI revival engine
# ---------------------------------------------------------------------------
# Provider selection: "ollama" (local inference) or "fallback" (deterministic).
# If Ollama is unreachable, the engine automatically degrades to the
# deterministic fallback so an analysis never crashes.
AI_PROVIDER=ollama

# Model served by the local Ollama instance.
AI_MODEL=glm-4.7-flash:latest

# Base URL of the local Ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434

# Per-request inference timeout in milliseconds.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Analyzer limits (optional overrides; safe defaults are built in)
# ---------------------------------------------------------------------------
# REPOREAPER_SCAN_ROOT=/tmp/reporeaper-scans
# REPOREAPER_MAX_FILES=1000
# REPOREAPER_MAX_DEPTH=6
# REPOREAPER_MAX_FILE_BYTES=512000
# REPOREAPER_MAX_REPO_BYTES=52428800
# REPOREAPER_CLONE_TIMEOUT_MS=30000
